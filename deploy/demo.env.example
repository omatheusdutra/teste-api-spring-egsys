# Copy to deploy/demo.env and replace every placeholder before deploying.
# The real deploy/demo.env file is intentionally ignored by Git.

IMAGE_TAG=prod
EGSYS_APP_BIND=127.0.0.1

EGSYS_DB_HOST=postgres
EGSYS_DB_PORT=5432
EGSYS_DB_NAME=egsys_tasks
EGSYS_DB_USERNAME=egsys_app
EGSYS_DB_PASSWORD=change-me-with-a-long-random-db-password
EGSYS_REDIS_PASSWORD=change-me-with-a-long-random-redis-password
EGSYS_ALLOWED_ORIGINS=https://tasks-api.example.com
EGSYS_PASSWORD_PEPPER=change-me-with-a-long-random-pepper

# Generate with:
# openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
# openssl rsa -pubout -in private.pem -out public.pem
#
# Store PEMs on one line using escaped newlines (\n). Example:
# -----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----
EGSYS_JWT_PRIVATE_KEY=replace-with-private-pem-using-escaped-newlines
EGSYS_JWT_PUBLIC_KEY=replace-with-public-pem-using-escaped-newlines

EGSYS_TRACING_SAMPLE_PROBABILITY=0.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
